/* =========================================================
   🍃 FALLING LEAVES
   ========================================================= */

.snowflakes {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    z-index: 999999 !important;
    overflow: hidden;
}

.snowflake {
    position: fixed !important;
    top: -10%;

    color: #235F38 !important;
    font-size: 28px;

    user-select: none;
    pointer-events: none;

    animation-name: leaf-fall, leaf-sway;
    animation-duration: 12s, 4s;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite;
}

/* Different starting positions */

.snowflake:nth-child(1) {
    left: 5%;
    animation-delay: 0s, 0s;
    font-size: 24px;
}

.snowflake:nth-child(2) {
    left: 15%;
    animation-delay: 3s, 1s;
    font-size: 32px;
}

.snowflake:nth-child(3) {
    left: 25%;
    animation-delay: 7s, 2s;
    font-size: 20px;
}

.snowflake:nth-child(4) {
    left: 35%;
    animation-delay: 2s, 1s;
    font-size: 30px;
}

.snowflake:nth-child(5) {
    left: 45%;
    animation-delay: 5s, 3s;
    font-size: 22px;
}

.snowflake:nth-child(6) {
    left: 55%;
    animation-delay: 9s, 0s;
    font-size: 34px;
}

.snowflake:nth-child(7) {
    left: 65%;
    animation-delay: 1s, 2s;
    font-size: 25px;
}

.snowflake:nth-child(8) {
    left: 75%;
    animation-delay: 6s, 1s;
    font-size: 30px;
}

.snowflake:nth-child(9) {
    left: 85%;
    animation-delay: 4s, 3s;
    font-size: 21px;
}

.snowflake:nth-child(10) {
    left: 95%;
    animation-delay: 8s, 0s;
    font-size: 28px;
}


/* Falling downward */

@keyframes leaf-fall {
    0% {
        top: -10%;
        opacity: 0;
        transform: rotate(0deg);
    }

    10% {
        opacity: 0.9;
    }

    50% {
        opacity: 0.8;
    }

    90% {
        opacity: 0.7;
    }

    100% {
        top: 110%;
        opacity: 0;
        transform: rotate(360deg);
    }
}


/* Wind blowing sideways */

@keyframes leaf-sway {
    0% {
        margin-left: 0;
    }

    25% {
        margin-left: 80px;
    }

    50% {
        margin-left: -60px;
    }

    75% {
        margin-left: 100px;
    }

    100% {
        margin-left: 0;
    }
}
