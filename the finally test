/* =========================================================
   WOLVDEN DIVA THEME — FOREST / LEAF
   Main colors:
   #19382A — deep forest
   #235F38 — forest green
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Metamorphous&display=swap');

/* -------------------------
   CURSOR
   ------------------------- */



/* -------------------------
   BODY / BACKGROUND
   ------------------------- */

body {
    background-image: url("https://file.garden/aVc3cFd4aiZ_dmP1/Screenshot%202026-08-14%20003147.png") !important;
    background-size: cover !important;
    background-position: center center !important;
    background-attachment: fixed !important;
    background-repeat: no-repeat !important;

    font-family: 'Metamorphous', serif !important;
    text-transform: lowercase;
    font-size: 14px !important;

    filter: none !important;

    color: #19382A !important;
}

/* -------------------------
   MAKE METAMORPHOUS THE
   DEFAULT FONT EVERYWHERE
   ------------------------- */

html,
body,
button,
input,
select,
textarea,
.navbar-main,
.navbar-status,
.breadcrumb-nav,
#main,
#sidebar,
.card,
.card-header,
.card-body,
.table,
h1,
h2,
h3,
h4,
h5,
h6,
a,
.btn,
.small,
small,
p {
    font-family: 'Metamorphous', serif !important;
}

/* -------------------------
   MAIN NAVBAR
   ------------------------- */

.navbar-main {
    background-color: #19382A !important;
    height: 2.5rem !important;
    border-bottom: 2px solid #235F38 !important;
}

.mr-auto .nav-link {
    color: #F1EBDD !important;
    font-size: 25px !important;
    font-family: 'Metamorphous', serif !important;
    text-transform: lowercase !important;
    margin-left: 8px;
}

.mr-auto .nav-link:hover,
.navbar-status a,
.breadcrumb-item a:hover {
    color: #C8D9C6 !important;
    background: none !important;
    transition: 0.3s ease all !important;
}

/* Hide original icons */

i.fa.fa-paw,
i.fa.fa-globe-americas,
i.fa.fa-drumstick-bite,
i.fa.fa-comments,
i.fa.fa-feather-alt,
i.fa.fa-calendar-alt,
i.fa.fa-gem,
i.fa.fa-question-circle {
    margin: -0.3rem !important;
    opacity: 0 !important;
}

/* -------------------------
   NAV STATUS
   ------------------------- */

.navbar-status {
    background-color: #235F38 !important;
}

.breadcrumb-nav {
    background-color: rgba(35, 95, 56, 0.94) !important;
    border: 2px solid #19382A !important;
    border-radius: 5rem;
    margin: 6px;
}

.breadcrumb-item,
.breadcrumb-item a,
.navbar-text,
.alert-info {
    color: #F1EBDD !important;
}

.breadcrumb-item::before,
i.text-muted,
#sidebar h3,
#sidebar h4,
tr.pup {
    color: #19382A !important;
    font-size: 14px !important;
}

/* -------------------------
   SIDEBAR
   ------------------------- */

#sidebar {
    background-color: rgba(25, 56, 42, 0.35) !important;
    border: 2px solid rgba(25, 56, 42, 0.75) !important;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
}

#sidebar .card {
    background-color: rgba(244, 240, 231, 0.30) !important;
    padding: 0 !important;
    margin-bottom: 10px;
    margin-top: 10px;
    color: #19382A !important;
    border-radius: 1rem !important;
    border: 2px solid rgba(35, 95, 56, 0.75) !important;
}

#sidebar .small span {
    color: #19382A !important;
    font-size: 12px !important;
    margin-bottom: 6px !important;
    margin-top: 6px !important;
}

/* -------------------------
   COLORED ALERTS / BOXES
   ------------------------- */

.bg-info {
    background-color: #235F38 !important;
    border: 2px solid #19382A !important;
    border-radius: 5rem;
    color: #F4F0E7 !important;
}

.bg-danger {
    background-color: #D8E5D5 !important;
    border: 2px solid #235F38 !important;
    border-radius: 5rem;
    color: #19382A !important;
}

.bg-primary {
    background-color: #235F38 !important;
    border: 2px solid #19382A !important;
    border-radius: 5rem;
    color: #F4F0E7 !important;
}

.bg-warning {
    background-image: url("https://file.garden/aVc3cFd4aiZ_dmP1/Screenshot%202026-08-14%20003553.png") !important;
    background-size: cover !important;
    background-position: center !important;
    border: 2px solid #19382A !important;
    border-radius: 5rem;
    color: #19382A !important;
}

.bg-success {
    background-color: #C8D9C6 !important;
    border: 2px solid #235F38 !important;
    border-radius: 5rem;
    color: #19382A !important;
}

/* -------------------------
   MAIN CONTENT
   ------------------------- */

#main {
    background: rgba(244, 240, 231, 0.20) !important;
    border: 2px solid rgba(35, 95, 56, 0.75) !important;
    color: #19382A !important;
    backdrop-filter: none !important;
}

#main .card {
    border: 2px solid rgba(35, 95, 56, 0.75) !important;
    background: rgba(244, 240, 231, 0.20) !important;
    margin-bottom: 0.5rem;
}

/* -------------------------
   ALERTS
   ------------------------- */

.alert {
    border-radius: 5rem !important;
    color: #19382A !important;
    padding: 0.5rem 1rem;
    margin-bottom: 1rem;
    border: 2px solid #19382A !important;
    background-color: #C8D9C6 !important;
    text-align: center !important;
}

.alert-danger {
    border: 2px solid #235F38 !important;
    background-color: #D8E5D5 !important;
    color: #19382A !important;
    text-align: center !important;
}

/* -------------------------
   PROGRESS
   ------------------------- */

.progress {
    color: transparent;
    background-color: transparent !important;
    margin-bottom: 0.5rem !important;
}

/* -------------------------
   HEADINGS
   ------------------------- */

h1 {
    color: #19382A !important;
    font-size: 20px !important;
    font-family: 'Metamorphous', serif !important;
    margin-left: 1rem;
}

h3 a {
    font-family: 'Metamorphous', serif !important;
    font-size: 20px !important;
    color: #235F38 !important;
    padding-left: 1rem;
    padding-right: 1rem;
}

/* -------------------------
   TABLES
   ------------------------- */

.border-none .striped,
.border-none .striped tr {
    background: transparent !important;
    color: #19382A !important;
}

.table {
    background-color: rgba(244, 240, 231, 0.20) !important;
    color: #19382A !important;
}

.table th {
    color: #F4F0E7 !important;
    background-color: #19382A !important;
    padding: 0.6rem 0.6rem 0.6rem 1rem !important;
}

.table th a,
.navbar-status a:hover {
    color: #D8E5D5 !important;
}

.table-striped tbody tr:nth-of-type(odd) {
    background-color: transparent !important;
}

.table .left {
    background-color: #D8E5D5 !important;
    border-radius: 0 !important;
}

.table .bottom,
.table tfoot td {
    color: #19382A !important;
    background-color: transparent;
    border-radius: 0 0 10px 10px !important;
    text-align: center;
}

.table thead th,
tbody {
    border: 1px solid transparent !important;
}

/* -------------------------
   LINKS
   ------------------------- */

a,
.s-chat-message__pinned,
body.theme_dark,
.text-td-bottom {
    color: #235F38 !important;
    background-color: transparent;
}

a:hover {
    color: #19382A !important;
    transition: 0.3s ease all !important;
    text-decoration: none !important;
}

/* -------------------------
   TABS
   ------------------------- */

.nav-tabs .nav-item.show .nav-link,
.nav-tabs .nav-link.active {
    background-color: #D8E5D5 !important;
    border: 2px solid #235F38 !important;
    color: #19382A !important;
    border-radius: 0.5rem;
}

.nav-tabs .nav-link,
.nav-tabs {
    border: none !important;
    color: #235F38 !important;
    border-radius: 0.5rem;
    border-bottom: 1px solid transparent;
}

.nav-tabs:hover .nav-link:hover {
    color: #F4F0E7 !important;
    background-color: #235F38 !important;
    border-radius: 0.5rem;
    border: 0.15rem solid #19382A !important;
    transition: none !important;
}

/* -------------------------
   BUTTONS
   ------------------------- */

.btn-success,
button#submitBtn {
    color: #F4F0E7 !important;
    background-color: #235F38 !important;
    border-color: #19382A !important;
    font-family: 'Metamorphous', serif !important;
    text-transform: lowercase;
    border-radius: 5rem !important;
}

.btn-success:hover,
button#submitBtn:hover {
    filter: brightness(1.15) !important;
    transition: filter 0.2s !important;
    box-shadow: none !important;
}

.btn-danger,
.btn-warning {
    color: #F4F0E7 !important;
    background-color: #235F38 !important;
    border-color: #19382A !important;
    text-transform: lowercase !important;
}

.btn-danger:hover,
.btn-warning:hover {
    filter: brightness(1.15) !important;
    transition: filter 0.2s !important;
    box-shadow: none !important;
}

.btn,
.btn:hover {
    border-radius: 5rem !important;
    box-shadow: none !important;
    border: 2px solid #19382A;
}

.btn-info {
    color: #19382A !important;
    background-color: #C8D9C6 !important;
    border-color: #235F38 !important;
    text-transform: lowercase !important;
    border-radius: 5rem !important;
}

.btn-info:hover {
    filter: brightness(0.95);
    transition: filter 0.2s !important;
}

/* -------------------------
   CARDS
   ------------------------- */

.card-header,
#footer,
#dencards {
